# Cloudflare Pages — سرایندهای امنیتی و کش
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# فایل‌های ایستا نسخه‌دار هستند (?v=N) و می‌توانند طولانی کش شوند
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/logo/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000

# صفحه‌ها باید تازه بمانند تا ویرایش محتوا زود دیده شود. نشانی صفحه‌ها بی‌پسوند است
# (/about، /services/cognitive)، پس قاعده‌ی ‎/*.html به آن‌ها نمی‌رسد؛ پیش‌فرض خودِ
# Cloudflare Pages برای آن‌ها همین است: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
